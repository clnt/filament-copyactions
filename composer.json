{
    "name": "webbingbrasil/filament-copyactions",
    "description": "A easy-to-use copy actions for Filament Admin.",
    "keywords": [
        "laravel",
        "filament"
    ],
    "homepage": "https://github.com/webbingbrasil/filament-copyactions",
    "license": "MIT",
    "authors": [
        {
            "name": "Danilo Andrade",
            "email": "danilo@webbingbrasil.com.br",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "livewire/livewire": "^3.0",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Webbingbrasil\\FilamentCopyActions\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webbingbrasil\\FilamentCopyActions\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webbingbrasil\\FilamentCopyActions\\FilamentCopyActionsProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --coverage-html=coverage --coverage-text"
    }
}
